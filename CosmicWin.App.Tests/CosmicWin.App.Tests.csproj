<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- WU28: WMI process-ancestry walk for the desktop test's fail-fast safety check; test-only. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- T9 (alert-tile-mosaic): the committed Node vm-sandbox harness proving alert-layer.js's own
         tile-layout math. AlertLayerLayoutNodeTests shells out to `node` and passes it this file's
         resolved output path, mirroring how CosmicWin.App's own Content items already copy
         alert-layer.js next to the test assembly for AlertLayerWebPageTests to read. -->
    <Content Include="Alerts\Web\alert-layer-layout.tests.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- html-wallpaper-demo D2: the committed Node vm-sandbox harness proving the processing-scene
         wallpaper page's own contract (ProcessingSceneNodeTests shells out to `node` and passes it
         this file's resolved output path, same technique as alert-layer-layout.tests.js above). -->
    <Content Include="Wallpaper\Web\processing-scene.tests.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- html-wallpaper-demo D6a: the committed Node vm-sandbox harness proving the explorer-scene
         wallpaper page's own contract (ExplorerSceneNodeTests shells out to `node` and passes it this
         file's resolved output path, same technique as processing-scene.tests.js above). -->
    <Content Include="Wallpaper\Web\explorer-scene.tests.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- html-wallpaper-demo D6b: the committed Node vm-sandbox harness proving the raphael-scene
         wallpaper page's own contract (RaphaelSceneNodeTests shells out to `node` and passes it this
         file's resolved output path, same technique as processing-scene.tests.js above). -->
    <Content Include="Wallpaper\Web\raphael-scene.tests.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- html-wallpaper-demo D6c: the committed Node vm-sandbox harness proving the idle-scene
         wallpaper page's own contract (IdleSceneNodeTests shells out to `node` and passes it this
         file's resolved output path, same technique as explorer-scene.tests.js above). -->
    <Content Include="Wallpaper\Web\idle-scene.tests.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CosmicWin.App\CosmicWin.App.csproj" />
    <!-- Task 3.22: drives CosmicWin.Launcher.Program.Run directly with a fake IProcessRunner. -->
    <ProjectReference Include="..\CosmicWin.Launcher\CosmicWin.Launcher.csproj" />
    <!-- WU28: reuses the existing hardened SpawnedNotepadWindow spawn/dispose harness. -->
    <ProjectReference Include="..\CosmicWin.Interop.Tests\CosmicWin.Interop.Tests.csproj" />
  </ItemGroup>
</Project>
