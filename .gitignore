# Reference checkouts -- read-only study material, never product source and never distributed.
# Their terms are incompatible with this project's MIT licence, and nothing here was copied.
/docs/reference/

# Local tooling state: machine-specific caches and indexes, useful to whoever is working here and
# meaningless to anyone else. .engram/config.json was tracked before this and is untracked by the
# same commit -- listing a path in .gitignore does nothing for a file git is already following.
/.atl/
/.engram/
/.codegraph/

# .NET build output
bin/
obj/
*.user

# IDE
.vs/

# Unlocked copy the app is launched from (scripts/run.ps1), so the build tree stays writable.
run/
