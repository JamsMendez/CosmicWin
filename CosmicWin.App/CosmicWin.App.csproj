<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>CosmicWin.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Task 3.21 (ES-1/D6): always-elevated startup + PerMonitorV2 (WT-2). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Task 3.16 (WU11): UseWindowsForms implicitly globals System.Drawing/System.Windows.Forms,
         which collide with CosmicWin.Interop.Rectangle and WPF's System.Windows.Application across
         the rest of this project. Scope both back down to an explicit `using` in Tray/TrayIconHost.cs. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CosmicWin.Layout\CosmicWin.Layout.csproj" />
    <ProjectReference Include="..\CosmicWin.Interop\CosmicWin.Interop.csproj" />
  </ItemGroup>
</Project>
