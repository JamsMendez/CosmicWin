<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Task 3.22 (D6): asInvoker, so double-clicking this shim never triggers UAC (unlike
       CosmicWin.App.exe, task 3.21). It only asks the already-registered elevated Scheduled Task
       (ES-2) to run, which elevates silently via its own RunLevel HighestAvailable. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
